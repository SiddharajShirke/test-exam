{
  "name": "api",
  "version": "1.0.0",
  "description": "AI Candidate Assessment Platform — Backend API",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:contract": "vitest run test/contract",
    "migrate": "ts-node src/migrations/runner.ts",
    "seed:tenant": "ts-node scripts/seed-tenant.ts",
    "db:up": "docker compose up -d mssql azurite",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d mssql azurite"
  },
  "dependencies": {
    "@azure/communication-email": "1.0.0",
    "@azure/storage-blob": "12.24.0",
    "applicationinsights": "3.4.0",
    "argon2": "0.41.1",
    "cookie-parser": "1.4.7",
    "express": "4.21.1",
    "helmet": "8.0.0",
    "mssql": "11.0.1",
    "openai": "4.67.1",
    "pdf-parse": "1.1.1",
    "pdfkit": "0.15.0",
    "uuid": "11.0.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/mssql": "9.1.5",
    "@types/node": "22.9.0",
    "@types/pdf-parse": "1.1.4",
    "@types/pdfkit": "0.13.5",
    "@types/supertest": "6.0.2",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.14.0",
    "@typescript-eslint/parser": "8.14.0",
    "eslint": "9.14.0",
    "supertest": "7.0.0",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  },
  "allowScripts": {
    "argon2@0.41.1": true,
    "esbuild@0.21.5": true,
    "protobufjs@7.6.6": true
  }
}
