# Node.js environment
NODE_ENV=development
PORT=8080

# Database (local SQL Server via docker-compose)
DATABASE_URL=Server=localhost,1433;Database=assessdb;User ID=sa;Password=Dev!Pass123;Encrypt=false;TrustServerCertificate=true;Connection Timeout=30;

# Session & Platform security (at least 32 chars in production)
SESSION_SECRET=local-dev-session-secret-change-in-prod-32chars
PLATFORM_KEY=local-dev-platform-key-change-in-prod-32chars

# AI provider (fake|azure)
AI_MODE=fake
FOUNDRY_ENDPOINT=https://placeholder.openai.azure.com/
FOUNDRY_KEY=placeholder-key
FOUNDRY_DEPLOYMENT=gpt-4o
FOUNDRY_API_VERSION=2024-02-01

# Email provider (fake|azure)
EMAIL_MODE=fake
ACS_CONNECTION_STRING=placeholder-acs-connection-string
ACS_SENDER=DoNotReply@placeholder.azurecomm.net

# File storage provider (azurite|azure)
FILES_MODE=azurite
BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=dev_placeholder_account_key;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
BLOB_CONTAINER=jd-files

# Application Insights (optional locally)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# App URLs
APP_BASE_URL=http://localhost:8080
API_INTERNAL_URL=http://localhost:8080

# Job loop
JOB_LOOP_ENABLED=true

# Git SHA (set by CI)
GIT_SHA=local

# Retention (days; optional)
RETENTION_DAYS=180

